--------------------------------------------------
-- KEYBOARD INPUTS
--------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gp)

	if gp then return end

	-- Toggle Aim
	if input.KeyCode == Enum.KeyCode.B then
		aiming = not aiming
		updateAimUI()
	end

	-- Giữ CTRL để mở khóa chuột
	if input.KeyCode == Enum.KeyCode.LeftControl
		or input.KeyCode == Enum.KeyCode.RightControl then

		mouseUnlockedByCtrl = true

		ctrlModalBtn.Visible = true
		fakeCursorGui.Enabled = true

		updateMouseState()
		UserInputService.MouseIconEnabled = true
	end

	-- Giữ chuột trái để Aim (chế độ FOV)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not dragging then
	    aimHeld = true
	end

end)

UserInputService.InputEnded:Connect(function(input)

	-- Thả CTRL
	if input.KeyCode == Enum.KeyCode.LeftControl
		or input.KeyCode == Enum.KeyCode.RightControl then

		mouseUnlockedByCtrl = false

		ctrlModalBtn.Visible = false
		fakeCursorGui.Enabled = false

		updateMouseState()
	end

	-- Thả chuột trái
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		aimHeld = false
	end

end)

sliderFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
	end
end)

sliderFrame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mouseX = UserInputService:GetMouseLocation().X
		local rel = math.clamp((mouseX - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)

		fovRadius = math.floor(30 + rel * 270) -- 30 → 300
		sliderFill.Size = UDim2.new(rel,0,1,0)
		sliderLabel.Text = "FOV : "..fovRadius
	end
end)

