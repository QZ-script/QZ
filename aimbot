-- PLAYER HOOK
--------------------------------------------------
local function hookPlayer(player)

	if espEnabled and player.Character then
		createESP(player)
	end

	player.CharacterAdded:Connect(function()
		task.wait(1)

		if espEnabled then
			removeESP(player)
			createESP(player)
		end
	end)
end

for _,plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		hookPlayer(plr)
	end
end

Players.PlayerAdded:Connect(function(plr)
	if plr ~= LocalPlayer then
		hookPlayer(plr)
	end
end)

Players.PlayerRemoving:Connect(removeESP)

--------------------------------------------------
-- AIM
--------------------------------------------------
local function getClosestHead()
	local closest = nil
	local bestMetric = math.huge
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer
			and plr.Character
			and (not teammateCheck or plr.Team ~= LocalPlayer.Team) then

			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local head = plr.Character:FindFirstChild("Head")

			if hum and hum.Health > 0 and head then
				local screenPos, visible = Camera:WorldToViewportPoint(head.Position)

				if visible then
					local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude

					if aimMode == "FOV" then
						if mouseDist <= fovRadius and mouseDist < bestMetric then
							bestMetric = mouseDist
							closest = head
						end
					else
						local worldDist = (head.Position - Camera.CFrame.Position).Magnitude

						if worldDist < bestMetric then
							bestMetric = worldDist
							closest = head
						end
					end
				end
			end
		end
	end

	return closest
end

local function hasLineOfSight(targetPart)

	local origin = Camera.CFrame.Position
	local direction = targetPart.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {
		LocalPlayer.Character,
		targetPart.Parent
	}

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	return result == nil
end

local function updateMouseState()

	if mouseUnlockedByCtrl then

		UserInputService.MouseBehavior =
			Enum.MouseBehavior.Default

		UserInputService.MouseIconEnabled = true

	elseif aiming then

		UserInputService.MouseBehavior =
			Enum.MouseBehavior.LockCenter

		UserInputService.MouseIconEnabled = false

	else

		UserInputService.MouseBehavior =
			Enum.MouseBehavior.Default

		UserInputService.MouseIconEnabled = true
	end
end

local function startAim()

	if aimConnection then return end

	aimConnection = RunService.RenderStepped:Connect(function()

		if mouseUnlockedByCtrl then
			return
		end

		local head = getClosestHead()

		if head and (aimMode == "DISTANCE" or aimHeld) then
			local target = CFrame.new(Camera.CFrame.Position, head.Position)
			Camera.CFrame = Camera.CFrame:Lerp(target, 0.18)

			if autoShoot
    			and (aimMode == "DISTANCE" or aimHeld)
    			and not clickDebounce
   				and hasLineOfSight(head) then

				clickDebounce = true

				VirtualInputManager:SendMouseButtonEvent(
					0,
					0,
					0,
					true,
					game,
					0
				)

				VirtualInputManager:SendMouseButtonEvent(
					0,
					0,
					0,
					false,
					game,
					0
				)

				task.delay(0.2,function()
					clickDebounce = false
				end)
			end
		end
	end)

	updateMouseState()
end

local function stopAim()

	if aimConnection then
		aimConnection:Disconnect()
		aimConnection = nil
	end

	updateMouseState()
end

