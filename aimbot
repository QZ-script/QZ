local function createESP(player)
	if espGuis[player] then return end
	if teammateCheck and player.Team == LocalPlayer.Team then return end

	local char = player.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")

	if not root then return end

	local bb = Instance.new("BillboardGui")
	bb.Name = "SimpleESP"
	bb.Adornee = root
	bb.AlwaysOnTop = true
	bb.StudsOffset = Vector3.new(0,3,0)
	bb.Size = UDim2.fromOffset(80,40)
	bb.Parent = LocalPlayer.PlayerGui

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1,1)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1,1,1)
	text.TextStrokeTransparency = 0
	text.TextStrokeColor3 = Color3.new(0,0,0)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 14
	text.TextWrapped = true
	text.Parent = bb

	espGuis[player] = {
		gui = bb,
		label = text
	}
end

local function removeESP(player)
	if espGuis[player] then
		espGuis[player].gui:Destroy()
		espGuis[player] = nil
	end
end

local function refreshESP()
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if espEnabled then
				createESP(plr)
			else
				removeESP(plr)
			end
		end
	end
end

RunService.RenderStepped:Connect(function()

	for plr,data in pairs(espGuis) do
		local char = plr.Character
		if not char then
			continue
		end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("Torso")

		if hum and hum.Health <= 0 then
			removeESP(plr)
			continue
		end

		if root and hum then
			data.gui.Adornee = root
			data.label.Text = plr.Name .. "\n" .. math.floor(hum.Health)

			local dist = (Camera.CFrame.Position - root.Position).Magnitude
			local scale = math.clamp(40 / dist,0.6,1.8)

			data.gui.Size = UDim2.fromOffset(80 * scale,40 * scale)
			data.label.TextSize = 14 * scale
		end
	end

	if fakeCursorGui.Enabled then
		local pos = UserInputService:GetMouseLocation()
		fakeCursor.Position = UDim2.fromOffset(pos.X,pos.Y)
	end

	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
	fovCircle.Size = UDim2.fromOffset(fovRadius*2, fovRadius*2)
	fovCircle.Visible = aiming and aimMode == "FOV"
end)

